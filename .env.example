# ═══════════════════════════════════════════════════════
# CIT Campus Scheduler — Environment Configuration
# ═══════════════════════════════════════════════════════
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Supabase Project ───────────────────────────────────

# Supabase project URL (public, not a secret)
SUPABASE_URL=https://your-project.supabase.co

# ── JWT Verification ───────────────────────────────────

# JWT algorithm: RS256 (recommended, uses JWKS) or HS256 (symmetric secret)
JWT_ALGORITHM=RS256

# JWT secret — required ONLY if JWT_ALGORITHM=HS256
# Found in Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# ── Database Connections ───────────────────────────────

# Application database (app_api role, transaction-mode pooler, port 6543)
DATABASE_URL=postgresql+psycopg://app_api:PASSWORD@db.your-project.supabase.co:6543/postgres

# Migration database (app_migrator role, direct connection, port 5432)
MIGRATION_DATABASE_URL=postgresql+psycopg://app_migrator:PASSWORD@db.your-project.supabase.co:5432/postgres

# Test database — NEVER use production here
TEST_DATABASE_URL=postgresql+psycopg://test_user:PASSWORD@localhost:5432/campus_scheduler_test

# ── Gemini LLM API ─────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ══ Demo Mode ═══════════════════════════════════════════
# Accept demo-token-* from the frontend without JWT verification.
# Set to true for hackathon judging / local development.
# MUST be false (or removed) in production.
DEMO_MODE=false
